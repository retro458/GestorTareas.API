# ============================================================
# Variables de la demo publica de TaskFlow.
# Copiar a /etc/taskflow/taskflow-demo.env (chmod 600) y completar.
# NUNCA versionar el archivo real ni meterlo en la imagen.
# ============================================================

# Modo demo: datos ficticios, cuentas de prueba, topes, sin correo.
Demo__Activo=true

# SQL Server en un contenedor aparte (misma red de Podman). La base y su
# login/usuario ya deben existir; el usuario necesita permiso para crear
# tablas (db_owner o db_ddladmin + db_datareader + db_datawriter) porque la
# app crea el esquema la primera vez y demo-reiniciar reinicia los IDENTITY.
DB_CONNECTION_STRING=Server=taskflow-sql,1433;Database=TaskFlowDemo;User Id=taskflow_demo;Password=CAMBIAR;Encrypt=True;TrustServerCertificate=True

# Clave del JWT: al menos 32 bytes aleatorios (openssl rand -hex 32).
JWT_SECRET_KEY=CAMBIAR
JWT_ISSUER=https://taskflow-demo.nodesv.com
JWT_AUDIENCE=https://taskflow-demo.nodesv.com
JWT_EXPIRATION_MINUTES=60

# URL publica de la demo (detras de Cloudflare Tunnel).
FRONTEND_URL=https://taskflow-demo.nodesv.com

# Correo: no hace falta. Con la demo activa no se envia nada (solo log),
# asi que RESEND_API_KEY / RESEND_FROM se dejan sin definir.
